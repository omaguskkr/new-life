rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /guestbook/{entryId} {
      // Visitors can list up to 50 public guestbook entries.
      allow list: if request.query.limit <= 50;
      // Anyone may submit a bounded name and message without signing in.
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['name', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 400
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
